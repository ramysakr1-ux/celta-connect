NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=
RESEND_API_KEY=

# Course close-out's 7-day grace-hold wipe (src/app/api/cron/course-close-out-wipe).
# Vercel automatically sends this same value as the cron request's Authorization
# header when it's set as a project env var on Vercel -- generate any random
# string and set it in both places (here for local testing, and on Vercel).
CRON_SECRET=

# Client-side Drive/Docs picker for TP materials (see src/lib/google/picker-client.ts).
# The OAuth token it browses with comes from the center's server-side connection
# (src/lib/google/oauth.ts), not the browser -- this key is only the Picker widget's
# own developer key (HTTP referrer restricted) with the Google Picker API enabled.
NEXT_PUBLIC_GOOGLE_API_KEY=

# Public site origin, used to build absolute links in emails (invites, offers)
# and OAuth callbacks. Falls back to SITE_URL then a hardcoded default if unset
# (src/app/dashboard/admin/courses/[id]/invitation-actions.ts and others) --
# set this explicitly in production so those links point at the real domain.
NEXT_PUBLIC_SITE_URL=

# AI marking/reading assist (src/lib/anthropic/client.ts) -- admissions AI
# triage's selection-task reading, task_feedback_ai_suggestion. ANTHROPIC_MODEL
# is optional, defaults to claude-sonnet-5 if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Whisper transcription (src/lib/openai/transcribe.ts, volunteer sign-up audio)
# and the admissions selection-task reading pipeline (src/lib/openai/read-selection-task.ts).
OPENAI_API_KEY=

# Card payments via Stripe (src/lib/payments/stripe-adapter.ts). Only needed
# once a centre actually connects Stripe as their provider -- checkout still
# works without it via bank transfer/cash/manual marking.
STRIPE_SECRET_KEY=
# Verifies incoming Stripe webhook events (payment_succeeded/failed/refunded) --
# without it, payment_provider_transactions never gets written and instalments
# never auto-confirm.
STRIPE_WEBHOOK_SECRET=

# Verifies incoming Resend delivery webhooks (src/app/api/webhooks/resend/route.ts)
# -- without it, applicant_emails' delivered/opened/bounced state never updates
# and the bounce-twice escalation never fires. Unsigned events are refused once
# this is set; leaving it unset accepts unsigned events (fine for local dev only).
RESEND_WEBHOOK_SECRET=

# Web Push notifications (src/lib/push/send.ts) -- volunteer "starts in 30 min"
# reminder and individual-tutorial cancellation. Generate all three with
# `npx web-push generate-vapid-keys`; VAPID_SUBJECT is a mailto: or https:
# contact URL required by the push spec. NEXT_PUBLIC_VAPID_PUBLIC_KEY must be
# the same value as VAPID_PUBLIC_KEY -- the client needs its own copy to
# subscribe, the server needs it (plus the private key) to actually send.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
