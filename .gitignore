# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache
supabase/.temp

# Working copies dragged in for one-off reference. The design files that
# ARE the authority live in design-sources/ and are tracked; anything else
# landing in the root is a scratch copy and should not be committed.
/Untitled.pdf
/*.zip
/_*.html
.env.migration
scripts/migration/rollback-values.json
